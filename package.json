{
  "name": "dsh-a-stock-analysis",
  "version": "0.1.0",
  "description": "A股投资研究方法论：四大视角（市场分析/财务分析/市场情绪/投资策略）+ AKShare 数据工具指引 + 8 阶段任务分解。纯技能零 API key。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src", "dist", "lib", "skills",
    "locale/*.json", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"
  ],
  "keywords": ["dsh-plugin", "deepseek-harness", "stock", "a-stock", "investment"],
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "devDependencies": { "esbuild": "^0.25.10" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/lib.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "prepack": "npm run build"
  }
}
